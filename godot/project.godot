; Shattered Empires native client (Godot 4.7). A thin view of the authoritative Node.js server:
; it renders synchronized state and sends intents, and never simulates rules of its own.

config_version=5

[application]

config/name="Shattered Empires (Native)"
config/description="Native 3D client for the Shattered Empires server"
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[shader_globals]

fog_view_size={
"type": "float",
"value": 34.0
}

wind_vector={
"type": "vec2",
"value": Vector2(0.4, 0.1)
}

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/dpi/allow_hidpi=true
window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[rendering]
textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.11, 0.12, 0.13, 1)
