/* Main menu and multiplayer lobby (UI spec B15/B16, owner Impl-4).
   The frame is anchored top/bottom (viewport − 128, min 560) and has a fixed width: 460 on root pages,
   880 on wide pages. Nothing inside changes its size with text: labels that hold changing text are
   single-line with an ellipsis and a fixed height; long content scrolls inside the page. */

.se-menu { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 7, 8, 0.12); }

.se-menu-frame {
    position: absolute; left: 64px; top: 64px; bottom: 64px; width: 460px; min-height: 560px;
    flex-direction: column; padding: 24px 24px 10px 24px;
    background-color: var(--se-surface-1, rgba(14, 21, 24, 0.92));
    border-width: 1px; border-color: var(--se-line, rgba(255, 255, 255, 0.08));
    border-left-width: 2px; border-left-color: var(--se-accent-dim, rgba(226, 182, 96, 0.35));
    border-radius: 6px;
}
/* two classes beat SE.uss's .se-frame--wide (the pause frame's fixed 880×720): this frame keeps its anchoring */
.se-menu-frame.se-frame--wide, .se-menu-frame.se-menu-frame--wide { width: 880px; height: auto; max-height: none; }

.se-menu-page-host { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.se-menu-page { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: column; }

/* footer of the whole frame: status line (28) and version (20) */
.se-menu-foot { flex-shrink: 0; height: 48px; margin-top: 8px; border-top-width: 1px; border-top-color: var(--se-line, rgba(255, 255, 255, 0.08)); }
.se-menu-status {
    height: 28px; min-height: 28px; max-height: 28px; font-size: 13px; color: var(--se-text, rgb(232, 226, 210));
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; padding: 0; margin: 0;
}
.se-menu-version { height: 20px; font-size: 11px; color: var(--se-text-dim, rgb(150, 164, 160)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; padding: 0; margin: 0; }

/* root: fixed title block */
.se-menu-title-block { height: 150px; min-height: 150px; flex-shrink: 0; justify-content: center; }
.se-menu-title {
    -unity-font: resource("Fonts/CormorantGaramond"); font-size: 56px; height: 62px; letter-spacing: 6px;
    color: rgb(244, 232, 202); white-space: nowrap; overflow: hidden; -unity-text-align: middle-left; margin: 0; padding: 0;
}
.se-menu-list { flex-shrink: 0; margin-top: 8px; }

/* menu items: 56 tall, icon 24, label 20 SemiBold */
.se-menu-item {
    height: 56px; min-height: 56px; margin: 0 0 6px 0; padding: 0 16px; flex-direction: row; align-items: center;
    -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 20px; letter-spacing: 1px; -unity-text-align: middle-left;
    flex-shrink: 0;
}
.se-menu-item IconElement { width: 24px; height: 24px; min-width: 24px; margin: 0 14px 0 0; }
.se-menu-item Label { font-size: 20px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.se-menu-item--primary { background-color: rgb(167, 136, 80); border-color: rgb(214, 178, 108); }
.se-menu-item--primary Label { color: rgb(24, 20, 12); }
.se-menu-item--primary:hover { background-color: rgb(196, 158, 88); }

.se-menu-quit-slot { height: 56px; min-height: 56px; flex-shrink: 0; }
.se-menu-quit-confirm { height: 56px; flex-direction: row; align-items: center; padding: 0 0 0 16px; background-color: var(--se-surface-2, rgba(30, 40, 43, 0.96)); border-radius: 4px; border-width: 1px; border-color: var(--se-warn, rgb(240, 188, 86)); }
.se-menu-quit-label { font-size: 20px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); }
.se-menu-quit-confirm .se-menu-action { width: 72px; margin-right: 8px; }

/* sub pages: header 56 · content (scrolls) · footer 64 */
.se-menu-header { height: 56px; min-height: 56px; flex-shrink: 0; flex-direction: row; align-items: center; margin-bottom: 8px; }
.se-menu-page-title {
    font-size: 28px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); color: rgb(244, 232, 202); margin-left: 12px;
    flex-grow: 1; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left;
}
.se-menu-content { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.se-menu-content--fill { flex-direction: column; }
.se-menu-footer { height: 64px; min-height: 64px; flex-shrink: 0; flex-direction: row; align-items: center; border-top-width: 1px; border-top-color: var(--se-line, rgba(255, 255, 255, 0.08)); margin-top: 8px; }
.se-menu-spacer { flex-grow: 1; }
.se-menu-grow { flex-grow: 1; flex-shrink: 1; }
.se-menu-row { flex-direction: row; align-items: center; }

.se-menu-action { height: 36px; min-height: 36px; padding: 0 14px; margin: 0 0 0 8px; flex-direction: row; align-items: center; flex-shrink: 0; }
.se-menu-footer .se-menu-action--lead { margin-left: 0; }
.se-menu-action--primary { min-width: 140px; justify-content: center; }
.se-menu-action IconElement { width: 18px; height: 18px; margin-right: 6px; }

.se-menu-label { font-size: 13px; color: var(--se-text-dim, rgb(150, 164, 160)); margin: 12px 0 2px 0; height: 20px; min-height: 20px; padding-top: 0; padding-bottom: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-menu-help-line { height: 20px; min-height: 20px; font-size: 13px; color: var(--se-text-dim, rgb(150, 164, 160)); margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-menu-note { min-height: 20px; font-size: 13px; color: var(--se-text-dim, rgb(150, 164, 160)); margin: 8px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-menu-note--wrap { white-space: normal; }
.se-menu-field { height: 36px; min-height: 36px; margin: 0; font-size: 15px; }
.se-menu-row .se-menu-field { margin-right: 8px; }

/* skirmish: two columns of 400 */
.se-menu-columns { flex-direction: row; justify-content: space-between; }
.se-menu-column { width: 400px; flex-shrink: 0; }

/* multiplayer */
.se-menu-host-row { flex-direction: row; align-items: center; margin-bottom: 6px; flex-shrink: 0; }
.se-menu-host-row .se-menu-item { margin: 0 8px 0 0; }
.se-menu-team-size { flex-shrink: 0; }
.se-menu-disclosure { align-self: flex-start; margin: 4px 0 0 0; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.se-menu-advanced { padding: 0 0 8px 0; }
.se-menu-advanced .se-menu-action { margin-left: 0; margin-right: 8px; }

/* join a friend */
.se-menu-empty { font-size: 17px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); margin: 16px 0 4px 0; }
.se-menu-friend { flex-direction: row; align-items: center; height: 48px; padding: 0 8px; margin-bottom: 4px; background-color: var(--se-surface-2, rgba(30, 40, 43, 0.96)); border-radius: 4px; }
.se-menu-avatar { width: 32px; height: 32px; border-radius: 16px; background-color: rgba(0, 0, 0, 0.35); align-items: center; justify-content: center; flex-shrink: 0; }
.se-menu-avatar IconElement { width: 20px; height: 20px; }
.se-menu-friend-names { flex-grow: 1; flex-shrink: 1; margin-left: 10px; min-width: 0; }
.se-menu-friend-name { font-size: 15px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-menu-friend-lobby { font-size: 12px; color: var(--se-text-dim, rgb(150, 164, 160)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-menu-friend-slots { width: 44px; font-size: 13px; -unity-text-align: middle-right; flex-shrink: 0; }
.se-menu-friend-join { width: 96px; min-width: 96px; }
.se-menu-friend-join.se-menu-friend-invite { width: 136px; min-width: 136px; }

/* join by code */
.se-menu-code-field { height: 48px; min-height: 48px; font-size: 26px; letter-spacing: 4px; }

/* lobby */
.se-lobby-code-row { flex-direction: row; align-items: center; height: 48px; min-height: 48px; flex-shrink: 0; }
.se-lobby-code-caption { margin: 0 12px 0 0; }
.se-lobby-code {
    width: 150px; height: 36px; font-size: 24px; letter-spacing: 4px; -unity-text-align: middle-center; margin-right: 8px;
    color: var(--se-accent, rgb(226, 182, 96)); background-color: rgba(0, 0, 0, 0.35); border-radius: 4px; white-space: nowrap; overflow: hidden;
}
.se-lobby-teams { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.se-lobby-team { width: 400px; margin: 0 16px 12px 0; padding: 8px; background-color: rgba(0, 0, 0, 0.22); border-radius: 6px; border-width: 1px; border-color: var(--se-line, rgba(255, 255, 255, 0.08)); }
.se-lobby-team-title { font-size: 13px; color: var(--se-text-dim, rgb(150, 164, 160)); height: 20px; margin-bottom: 4px; }
.se-lobby-seat { flex-direction: row; align-items: center; height: 44px; min-height: 44px; padding: 0 8px; }
.se-lobby-dot { width: 12px; height: 12px; border-radius: 6px; margin-right: 10px; flex-shrink: 0; border-width: 2px; border-color: var(--se-text-dim, rgb(150, 164, 160)); }
.se-lobby-dot--taken { background-color: var(--se-text, rgb(232, 226, 210)); border-color: var(--se-text, rgb(232, 226, 210)); }
.se-lobby-dot--you { background-color: var(--se-friendly, rgb(74, 150, 255)); border-color: var(--se-friendly, rgb(74, 150, 255)); }
.se-lobby-dot--open { background-color: rgba(0, 0, 0, 0); }
.se-lobby-seat-name { flex-grow: 1; flex-shrink: 1; font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-lobby-seat-name--open { color: var(--se-text-dim, rgb(150, 164, 160)); -unity-font-style: italic; }
.se-lobby-seat-tags { width: 90px; font-size: 12px; color: var(--se-text-dim, rgb(150, 164, 160)); -unity-text-align: middle-right; margin-right: 8px; white-space: nowrap; overflow: hidden; flex-shrink: 0; }
.se-lobby-chip { height: 22px; padding: 0 8px; font-size: 12px; border-radius: 4px; background-color: var(--se-surface-2, rgba(30, 40, 43, 0.96)); -unity-text-align: middle-center; flex-shrink: 0; }
.se-lobby-ready { width: 20px; height: 20px; flex-shrink: 0; opacity: 0.45; }
.se-lobby-ready--on { opacity: 1; }
.se-lobby-map { height: 22px; font-size: 14px; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-lobby-waiting { font-size: 14px; color: var(--se-text-dim, rgb(150, 164, 160)); margin-left: 12px; width: 140px; -unity-text-align: middle-right; white-space: nowrap; }

/* field guide (also shown in the pause menu) */
.se-guide { flex-direction: column; }
.se-guide-search { margin-bottom: 8px; flex-shrink: 0; }
.se-guide-scroll { flex-grow: 1; }
.se-guide-entry { padding: 8px 4px 10px 0; border-bottom-width: 1px; border-bottom-color: var(--se-line, rgba(255, 255, 255, 0.08)); }
.se-guide-topic { font-size: 16px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); color: rgb(234, 204, 140); margin-bottom: 4px; }
.se-guide-text { font-size: 14px; white-space: normal; }
.se-guide-credits { margin-top: 12px; }

/* map picker (New Skirmish and Host lobby): one 36-high row per map, name left and team size right */
.se-map-list { flex-direction: column; flex-shrink: 0; }
.se-map-list--host { margin: 2px 0 8px 0; }
.se-map-option {
    height: 36px; min-height: 36px; margin: 0 0 4px 0; padding: 0 12px; flex-direction: row; align-items: center; flex-shrink: 0;
    background-color: var(--se-surface-2, rgba(30, 40, 43, 0.96)); border-width: 1px; border-color: var(--se-line, rgba(255, 255, 255, 0.08)); border-radius: 4px;
}
.se-map-option:hover { border-color: var(--se-accent-dim, rgba(226, 182, 96, 0.35)); }
.se-map-option.selected { border-color: var(--se-accent, rgb(226, 182, 96)); background-color: rgba(226, 182, 96, 0.14); }
.se-map-name { flex-grow: 1; flex-shrink: 1; font-size: 15px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; margin: 0; padding: 0; }
.se-map-mode { width: 48px; flex-shrink: 0; font-size: 13px; color: var(--se-text-dim, rgb(150, 164, 160)); -unity-text-align: middle-right; margin: 0; padding: 0; }
.se-map-option.selected .se-map-mode { color: var(--se-accent, rgb(226, 182, 96)); }
.se-map-help { height: 54px; min-height: 54px; max-height: 54px; font-size: 13px; color: var(--se-text-dim, rgb(150, 164, 160)); margin-top: 2px; white-space: normal; overflow: hidden; }

/* map picker with preview (New Skirmish, lobby): a preview card (the catalog's top-down grid with start
   positions; a plain card without one) over a filter row and the list. 400 wide (one menu column). */
.se-map-picker { flex-direction: column; flex-shrink: 0; }
.se-map-card { flex-direction: column; flex-shrink: 0; margin-bottom: 8px; padding: 8px; background-color: rgba(0, 0, 0, 0.22); border-radius: 6px; border-width: 1px; border-color: var(--se-line, rgba(255, 255, 255, 0.08)); }
.se-map-preview {
    width: 200px; height: 200px; flex-shrink: 0; align-self: center; margin-bottom: 8px; border-radius: 4px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.14); background-color: rgb(32, 42, 38); -unity-background-scale-mode: scale-to-fit;
    align-items: center; justify-content: center;
}
.se-map-preview--none { background-color: rgba(108, 122, 82, 0.35); }
.se-map-preview-empty { font-size: 28px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); color: rgba(244, 232, 202, 0.55); -unity-text-align: middle-center; }
.se-map-card-name { height: 22px; font-size: 17px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); color: rgb(244, 232, 202); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; padding: 0; }
.se-map-card-meta { height: 18px; font-size: 13px; color: var(--se-accent, rgb(226, 182, 96)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; padding: 0; }
.se-map-card-text { height: 54px; min-height: 54px; max-height: 54px; font-size: 13px; color: var(--se-text-dim, rgb(150, 164, 160)); white-space: normal; overflow: hidden; margin: 4px 0 0 0; padding: 0; }
.se-map-picker-list { flex-direction: column; flex-shrink: 0; }
.se-map-filter { flex-direction: row; flex-shrink: 0; margin-bottom: 6px; }
.se-map-filter-option { height: 26px; min-height: 26px; padding: 0 10px; margin: 0 6px 0 0; font-size: 13px; border-radius: 13px; background-color: var(--se-surface-2, rgba(30, 40, 43, 0.96)); border-width: 1px; border-color: var(--se-line, rgba(255, 255, 255, 0.08)); }
.se-map-filter-option.selected { border-color: var(--se-accent, rgb(226, 182, 96)); color: var(--se-accent, rgb(226, 182, 96)); }

/* AI lists (New Skirmish) and lobby seat controls */
.se-ai-list { flex-direction: column; flex-shrink: 0; }
.se-ai-row { flex-direction: row; align-items: center; height: 36px; min-height: 36px; padding: 0 8px; margin-bottom: 4px; background-color: rgba(0, 0, 0, 0.22); border-radius: 4px; }
.se-ai-row-name { flex-grow: 1; flex-shrink: 1; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; padding: 0; }
.se-team-dot { width: 10px; height: 10px; border-radius: 5px; margin-right: 8px; flex-shrink: 0; }
.se-cycle {
    width: 72px; min-width: 72px; height: 26px; min-height: 26px; margin: 0 0 0 6px; padding: 0 4px; font-size: 13px; flex-shrink: 0;
    border-radius: 4px; background-color: var(--se-surface-2, rgba(30, 40, 43, 0.96)); border-width: 1px; border-color: var(--se-line, rgba(255, 255, 255, 0.08));
    white-space: nowrap; overflow: hidden; -unity-text-align: middle-center;
}
.se-cycle:hover { border-color: var(--se-accent-dim, rgba(226, 182, 96, 0.35)); }
.se-lobby-format-row { flex-direction: row; align-items: center; height: 40px; min-height: 40px; flex-shrink: 0; margin-top: 4px; }
.se-lobby-format-caption { margin: 0 12px 0 0; }
.se-lobby-format { font-size: 16px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); color: var(--se-accent, rgb(226, 182, 96)); }
.se-menu-column .se-lobby-teams { flex-direction: column; flex-wrap: nowrap; margin-top: 4px; }
.se-menu-column .se-lobby-team { width: auto; margin: 0 0 10px 0; }
.se-lobby-team-head { flex-direction: row; align-items: center; height: 26px; margin-bottom: 2px; }
.se-lobby-team-head .se-lobby-team-title { height: 20px; margin: 0; }
.se-lobby-small { height: 26px; min-height: 26px; padding: 0 8px; margin: 0 0 0 6px; font-size: 12px; flex-shrink: 0; border-radius: 4px; }
.se-lobby-icon { flex-shrink: 0; margin-left: 4px; }
.se-menu-column .se-lobby-seat-tags { width: 64px; }

/* ---------------------------------------------------------------- menu review (2026-11-16): sections, fields,
   compact map card, seat rows, lobby rules and spectators */
.se-menu-section {
    font-size: 12px; letter-spacing: 2px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold");
    color: var(--se-accent, rgb(226, 182, 96)); height: 18px; margin: 18px 0 6px 0; padding: 0 0 4px 0;
    border-bottom-width: 1px; border-bottom-color: var(--se-line, rgba(255, 255, 255, 0.08));
    white-space: nowrap; overflow: hidden;
}
.se-menu-section--first { margin-top: 0; }
/* text fields: dark inset with light text (the default theme drew a white box with pale text) */
.se-menu-field .unity-base-text-field__input, .se-menu-field .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.45); color: var(--se-text, rgb(232, 226, 210));
    border-width: 1px; border-color: rgba(255, 255, 255, 0.14); border-radius: 4px; padding: 0 10px; -unity-text-align: middle-left;
}
.se-menu-field:focus .unity-base-text-field__input { border-color: var(--se-accent, rgb(226, 182, 96)); }
.se-menu-field .unity-text-element { color: var(--se-text, rgb(232, 226, 210)); }
.se-menu-field { background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; }

/* small buttons in seat rows: the menu's dark button, not the default theme's light one */
.se-lobby-small {
    background-color: var(--se-surface-2, rgba(30, 40, 43, 0.96)); color: var(--se-text, rgb(232, 226, 210));
    border-width: 1px; border-color: rgba(255, 255, 255, 0.16); -unity-text-align: middle-center; white-space: nowrap;
}
.se-lobby-small:hover { border-color: var(--se-accent, rgb(226, 182, 96)); background-color: var(--se-surface-hover, rgba(52, 66, 66, 0.98)); }
.se-lobby-small:disabled { opacity: 0.35; }
.se-cycle { color: var(--se-text, rgb(232, 226, 210)); }
.se-map-filter-option { color: var(--se-text, rgb(232, 226, 210)); }
.se-map-filter-option:hover { border-color: var(--se-accent-dim, rgba(226, 182, 96, 0.35)); }
.se-map-option { color: var(--se-text, rgb(232, 226, 210)); }

/* seat rows (New Skirmish): you, allies and rivals; a closed seat reads as an empty slot */
.se-ai-list--seats { margin-top: 8px; }
.se-ai-row--you { background-color: rgba(74, 150, 255, 0.12); border-width: 1px; border-color: rgba(74, 150, 255, 0.35); }
.se-ai-row-tag { font-size: 13px; color: var(--se-text-dim, rgb(150, 164, 160)); margin: 0 4px 0 6px; padding: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 160px; }
.se-ai-row--closed { background-color: rgba(0, 0, 0, 0.10); border-width: 1px; border-color: rgba(255, 255, 255, 0.10); }
.se-ai-row-name--closed { color: var(--se-text-dim, rgb(150, 164, 160)); -unity-font-style: italic; }
.se-team-dot--empty { border-width: 1px; border-color: var(--se-text-dim, rgb(150, 164, 160)); }
.se-menu-random { flex-shrink: 0; }

/* map picker: a compact card (preview left, name and notes right) above the list */
.se-map-card { flex-direction: row; align-items: flex-start; }
.se-map-preview { width: 136px; height: 136px; min-width: 136px; margin: 0 12px 0 0; align-self: flex-start; }
.se-map-card-info { flex-grow: 1; flex-shrink: 1; min-width: 0; flex-direction: column; }
.se-map-card-text { height: auto; min-height: 0; max-height: 104px; margin-top: 6px; font-size: 12px; }

/* lobby */
.se-lobby-seat--closed { opacity: 0.8; }
.se-lobby-watch-row { flex-direction: row; align-items: center; min-height: 40px; flex-shrink: 0; }
.se-lobby-spectators { flex-grow: 1; flex-shrink: 1; font-size: 14px; color: var(--se-text-dim, rgb(150, 164, 160)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-lobby-rules { flex-shrink: 0; }
.se-lobby-rules-text { font-size: 14px; margin-top: 10px; white-space: normal; color: var(--se-text, rgb(232, 226, 210)); }
.se-lobby-team-head .se-lobby-small { height: 22px; min-height: 22px; }
.se-lobby-format-row { margin-bottom: 14px; }
.se-menu-host-row .se-menu-item { margin: 0; }

/* UI transitions (see SE.uss "UI transitions"): the frame eases between its narrow and wide widths; menu
   buttons ease their colour, lift slightly on hover and press in on click; rows ease their border */
.se-menu-frame { transition-property: width; transition-duration: 0.22s; transition-timing-function: ease-out; }
.se-menu-item, .se-menu-action, .se-lobby-small, .se-cycle, .se-map-filter-option {
    transition-property: background-color, border-color, color, scale; transition-duration: 0.12s; transition-timing-function: ease-out;
}
.se-menu-item:hover { scale: 1.02 1.02; }
.se-menu-action:hover, .se-lobby-small:hover, .se-cycle:hover, .se-map-filter-option:hover { scale: 1.03 1.03; }
.se-menu-item:active, .se-menu-action:active, .se-lobby-small:active, .se-cycle:active, .se-map-filter-option:active { scale: 0.97 0.97; }
.se-map-option, .se-menu-friend, .se-ai-row { transition-property: background-color, border-color; transition-duration: 0.12s; transition-timing-function: ease-out; }
.se-calm .se-menu-frame, .se-calm .se-menu-item, .se-calm .se-menu-action, .se-calm .se-lobby-small, .se-calm .se-cycle, .se-calm .se-map-filter-option { transition-duration: 0s; }
.se-calm .se-menu-item:hover, .se-calm .se-menu-action:hover, .se-calm .se-lobby-small:hover, .se-calm .se-cycle:hover, .se-calm .se-map-filter-option:hover { scale: 1 1; }
/* entrances (UiKit.Enter) on elements that have their own transitions above keep both */
.se-menu-frame.se-enter-anim { transition-property: opacity, translate, width; transition-duration: 0.2s; transition-timing-function: ease-out; }
.se-map-option.se-enter-anim, .se-menu-friend.se-enter-anim, .se-ai-row.se-enter-anim { transition-property: opacity, translate, background-color, border-color; transition-duration: 0.2s; transition-timing-function: ease-out; }
.se-calm .se-menu-frame.se-enter-anim, .se-calm .se-map-option.se-enter-anim, .se-calm .se-menu-friend.se-enter-anim, .se-calm .se-ai-row.se-enter-anim { transition-duration: 0s; }

/* map builder (MapBuilder.cs): paint canvas left (the world is 1.1547 : 1), tools right */
.se-builder { flex-direction: column; flex-shrink: 0; }
.se-builder-columns { flex-direction: row; justify-content: space-between; }
.se-builder-left { width: 462px; flex-shrink: 0; flex-direction: column; }
.se-builder-right { width: 330px; flex-shrink: 0; flex-direction: column; }
.se-builder-canvas {
    width: 460px; height: 398px; flex-shrink: 0; border-width: 1px; border-color: rgba(255, 255, 255, 0.18); border-radius: 4px;
    background-color: rgb(32, 42, 38); -unity-background-scale-mode: stretch-to-fill; overflow: hidden;
}
.se-builder-markers { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.se-builder-base {
    position: absolute; width: 20px; height: 20px; margin-left: -10px; margin-top: -10px; border-radius: 10px;
    border-width: 2px; border-color: rgb(250, 246, 236); font-size: 12px; -unity-font-style: bold; color: rgb(20, 20, 18);
    -unity-text-align: middle-center; padding: 0;
}
.se-builder-info { font-size: 13px; margin-top: 6px; white-space: normal; color: var(--se-text-dim, rgb(150, 164, 160)); }
.se-builder-info--warn { color: var(--se-warn, rgb(240, 188, 86)); }
.se-builder-right .se-segmented { margin-bottom: 4px; }
.se-builder-slot { align-items: center; min-height: 34px; }
.se-builder-slot-name { flex-grow: 1; flex-shrink: 1; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; }
.se-builder-slot-btn { min-width: 60px; margin-left: 4px; }

/* Ticket 4 (2026-11-20): map builder points of interest (MapBuilder.cs) and the custom-rules editor (MainMenu.Rules.cs) */
.se-builder-poi {
    position: absolute; width: 15px; height: 15px; margin-left: -7px; margin-top: -7px; border-radius: 3px;
    border-width: 1px; border-color: rgb(20, 20, 18); font-size: 10px; -unity-font-style: bold; color: rgb(20, 20, 18);
    -unity-text-align: middle-center; padding: 0; background-color: rgb(226, 182, 96);
}
.se-builder-poi--city { background-color: rgb(232, 226, 210); width: 17px; height: 17px; margin-left: -8px; margin-top: -8px; }
.se-builder-poi--cache { background-color: rgb(196, 160, 110); border-radius: 8px; }
.se-builder-poi--power { background-color: rgb(120, 200, 240); border-radius: 8px; }
.se-menu-rules-custom { margin-top: 6px; }
.se-menu-rules-custom .se-setting-row { min-height: 34px; }
.se-menu-rules-amount { width: 76px; min-width: 76px; margin-right: 8px; }
.se-cycle--income { min-width: 92px; }
