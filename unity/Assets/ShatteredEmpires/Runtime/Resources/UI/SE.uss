/* Shattered Empires interface: the battlefield is the screen (docs/UI_DESIGN_SPEC.md).
   - Surfaces: dark, slightly blue-green translucent glass; one warm brass accent for focus, hover and
     selection only (never ownership).
   - Type: Barlow Semi Condensed for everything functional, Cormorant for titles only.
   - Sizes are panel units at 1920x1080. Nothing jumps: changing text sits in fixed-width slots.
   - Only this sheet defines the --se-* tokens; SE.Command / SE.Minimap / SE.Menu use var(--se-...).
   Owner: Impl-1 (shell). Shared component classes: .se-btn, .se-icon-btn, .se-chip, .se-segmented,
   .se-setting-row, .se-switch, .se-slider-row, .se-cost-row, .se-frame / .se-frame--wide, .se-popover. */

:root {
    -unity-font: resource("Fonts/BarlowSemiCondensed-Regular");
    font-size: 15px;
    color: rgb(232, 226, 210);

    --se-surface-0: rgba(8, 12, 14, 0.80);
    --se-surface-1: rgba(14, 21, 24, 0.92);
    --se-surface-2: rgba(30, 40, 43, 0.96);
    --se-surface-hover: rgba(52, 66, 66, 0.98);
    --se-line: rgba(255, 255, 255, 0.08);
    --se-accent: rgb(226, 182, 96);
    --se-accent-dim: rgba(226, 182, 96, 0.35);
    --se-text: rgb(232, 226, 210);
    --se-text-dim: rgb(150, 164, 160);
    --se-good: rgb(142, 212, 132);
    --se-warn: rgb(240, 188, 86);
    --se-bad: rgb(242, 116, 96);
    --se-friendly: rgb(74, 150, 255);
    --se-ally: rgb(64, 200, 190);
    --se-neutral: rgb(200, 170, 110);
    --se-radius: 6px;
    --se-radius-small: 4px;
    --se-gap: 8px;
}

.se-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.glass {
    background-color: var(--se-surface-1);
    border-color: var(--se-line);
    border-top-color: var(--se-accent-dim);
    border-width: 1px;
    border-radius: var(--se-radius);
}

.title { -unity-font: resource("Fonts/CormorantGaramond"); font-size: 26px; color: rgb(242, 230, 198); margin-bottom: 6px; }
.heading { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 16px; color: rgb(234, 204, 140); margin-bottom: 4px; letter-spacing: 0.3px; }
.muted { color: var(--se-text-dim); font-size: 13px; }
.small { font-size: 13px; }
.micro { font-size: 11px; }
.good { color: var(--se-good); }
.bad { color: var(--se-bad); }
.warn { color: var(--se-warn); }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
.wrap { flex-wrap: wrap; }
.section { margin-top: 10px; padding-top: 8px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.06); }
.ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ================================================================ shared components (UiKit) */
.se-btn {
    -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold");
    height: 36px; min-height: 36px; padding: 0 12px; margin: 0;
    flex-direction: row; align-items: center; justify-content: center;
    background-color: var(--se-surface-2);
    border-width: 1px; border-color: var(--se-line);
    border-radius: var(--se-radius-small);
    color: var(--se-text); font-size: 15px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, translate;
    transition-duration: 0.12s;
}
.se-btn:hover { background-color: var(--se-surface-hover); border-color: rgba(226, 182, 96, 0.7); }
.se-btn:active { background-color: rgb(92, 78, 44); translate: 0 1px; }
.se-btn.selected { border-color: var(--se-accent); background-color: rgba(98, 82, 44, 0.96); }
.se-btn:disabled, .se-btn.se-disabled { opacity: 0.4; }
.se-btn.primary { background-color: var(--se-accent); border-color: rgb(244, 212, 140); color: rgb(22, 20, 14); }
.se-btn.primary:hover { background-color: rgb(238, 198, 118); }
.se-btn.se-alert-warn { border-color: var(--se-warn); }
.se-btn.se-alert-bad { border-color: var(--se-bad); }
.se-btn.se-danger:hover { background-color: rgba(170, 60, 40, 0.85); border-color: var(--se-bad); }
.se-btn-icon { width: 20px; height: 20px; margin-right: 8px; flex-shrink: 0; }
.se-btn-label { flex-shrink: 1; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-icon-btn { padding: 0; justify-content: center; }
.se-icon-btn .se-btn-icon { margin: 0; }

.se-chip {
    height: 36px; min-height: 36px; padding: 0 10px; margin: 0;
    flex-direction: row; align-items: center;
    background-color: var(--se-surface-2);
    border-width: 1px; border-color: var(--se-line);
    border-radius: var(--se-radius-small);
    color: var(--se-text);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}
.se-chip:hover { background-color: var(--se-surface-hover); border-color: rgba(226, 182, 96, 0.7); }
.se-chip:active { background-color: rgb(92, 78, 44); }
.se-chip.selected { border-color: var(--se-accent); background-color: rgba(98, 82, 44, 0.96); }
.se-chip.se-alert-warn { border-color: var(--se-warn); }
.se-chip.se-alert-bad { border-color: var(--se-bad); }
.se-chip-icon { width: 20px; height: 20px; margin-right: 8px; flex-shrink: 0; }

.se-segmented {
    flex-direction: row; height: 36px; flex-shrink: 0;
    background-color: var(--se-surface-2);
    border-width: 1px; border-color: var(--se-line); border-radius: var(--se-radius-small);
    overflow: hidden;
}
.se-segment {
    height: 100%; margin: 0; padding: 0; flex-shrink: 0;
    border-width: 0; border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center; justify-content: center;
    color: var(--se-text);
    transition-property: background-color; transition-duration: 0.12s;
}
.se-segment:hover { background-color: var(--se-surface-hover); }
.se-segment.selected { background-color: var(--se-accent); color: rgb(22, 20, 14); }
.se-segment:disabled { opacity: 0.4; }
.se-segment-label { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 14px; -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-segment.selected .se-segment-label { color: rgb(22, 20, 14); }
.se-segment-icon { width: 16px; height: 16px; }

.se-setting-row { flex-direction: row; align-items: center; height: 40px; min-height: 40px; flex-shrink: 0; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.04); }
.se-setting-label { width: 220px; flex-shrink: 0; padding-right: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-setting-control { flex-grow: 1; flex-shrink: 1; flex-direction: row; align-items: center; min-width: 0; }

.se-switch { margin: 0; padding: 0; flex-shrink: 0; }
.se-switch > .unity-toggle__input { margin: 0; padding: 0; }
.se-switch .unity-toggle__checkmark,
.se-switch .unity-toggle__input:checked > .unity-toggle__checkmark,
.se-switch:hover .unity-toggle__checkmark {
    width: 44px; height: 24px; margin: 0; padding: 0;
    border-radius: 12px; border-width: 1px; border-color: var(--se-line);
    background-color: rgba(255, 255, 255, 0.12);
    background-image: none;
}
.se-switch.se-switch--on .unity-toggle__checkmark,
.se-switch.se-switch--on .unity-toggle__input:checked > .unity-toggle__checkmark { background-color: var(--se-accent); border-color: rgb(244, 212, 140); }
.se-switch-knob {
    position: absolute; left: 2px; top: 2px; width: 18px; height: 18px; border-radius: 9px;
    background-color: var(--se-text-dim);
    transition-property: left, background-color; transition-duration: 0.12s;
}
.se-switch.se-switch--on .se-switch-knob { left: 22px; background-color: rgb(22, 20, 14); }

.se-slider-row { flex-direction: row; align-items: center; }
.se-slider { width: 280px; margin: 0; flex-shrink: 0; }
.se-slider .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.12); border-color: var(--se-line); }
.se-slider .unity-base-slider__dragger { background-color: var(--se-accent); border-color: rgb(244, 212, 140); }
.se-slider-value { width: 48px; margin-left: 12px; -unity-text-align: middle-right; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); }

.se-cost-row { flex-direction: row; align-items: center; }
.se-cost { flex-direction: row; align-items: center; margin-right: 8px; }
.se-cost-icon { width: 14px; height: 14px; margin-right: 3px; }
.se-cost-value { font-size: 13px; }
.se-cost--short { color: var(--se-bad); }

/* popovers and tooltips share one look */
.tooltip, .se-popover {
    position: absolute; padding: 10px 12px;
    background-color: rgba(8, 13, 15, 0.97); border-color: var(--se-accent-dim); border-width: 1px; border-radius: var(--se-radius);
}
.tooltip { width: 360px; }
.se-popover { width: 264px; }
.flow-row, .se-flow-row { flex-direction: row; justify-content: space-between; font-size: 13px; padding: 1px 0; }

/* fixed frames (pause menu, settings): the frame decides the size, content scrolls inside */
.se-dimmer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(4, 7, 8, 0.55); }
.se-frame {
    background-color: var(--se-surface-1);
    border-width: 1px; border-color: var(--se-line); border-top-color: var(--se-accent-dim);
    border-radius: var(--se-radius);
    padding: 12px 16px;
}
.se-pause-frame { width: 360px; height: 440px; max-height: 96%; }
.se-frame.se-frame--wide { width: 880px; height: 720px; max-width: 96%; max-height: 94%; }
.se-page { flex-grow: 1; min-height: 0; }
.se-page-header { flex-direction: row; align-items: center; height: 48px; flex-shrink: 0; }
.se-page-header .se-icon-btn { margin-right: 10px; }
.se-page-title { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 20px; letter-spacing: 3px; color: rgb(236, 210, 150); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-pause-item { height: 44px; min-height: 44px; margin: 0 0 4px 0; justify-content: flex-start; padding-left: 14px; }
.se-pause-item .se-btn-label { font-size: 16px; letter-spacing: 0.6px; }
.se-confirm-text { margin: 12px 0 20px 0; font-size: 16px; white-space: normal; }
.se-confirm-row { flex-direction: row; justify-content: flex-end; }
.se-confirm-row .se-btn { width: 120px; margin-left: 8px; }

/* settings view (B14): fills its frame */
.se-settings { flex-grow: 1; flex-direction: column; min-height: 0; }
.se-settings-header { flex-direction: row; align-items: center; height: 48px; flex-shrink: 0; border-bottom-width: 1px; border-color: var(--se-line); }
.se-settings-header .se-icon-btn { margin-right: 10px; }
.se-settings-title { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 20px; letter-spacing: 3px; color: rgb(236, 210, 150); }
.se-settings-body { flex-direction: row; flex-grow: 1; min-height: 0; margin-top: 10px; }
.se-settings-tabs { width: 168px; flex-shrink: 0; margin-right: 16px; }
.se-settings-tab { height: 40px; min-height: 40px; margin: 0 0 4px 0; justify-content: flex-start; padding-left: 14px; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); }
.se-settings-tab.selected { border-left-color: var(--se-accent); }
.se-settings-pane { flex-grow: 1; flex-shrink: 1; }
.se-settings-footer { flex-direction: row; align-items: center; justify-content: flex-end; height: 52px; flex-shrink: 0; border-top-width: 1px; border-color: var(--se-line); }
.se-settings-note { color: var(--se-text-dim); font-size: 13px; white-space: normal; padding: 8px 0; }
.se-key-label { width: 300px; flex-shrink: 0; padding-right: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-keycap { width: 120px; flex-shrink: 0; }
.se-keycap.selected .se-btn-label { color: var(--se-accent); }
.se-key-conflict { color: var(--se-warn); font-size: 13px; margin-left: 12px; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ================================================================ top bar (B2) */
.se-topbar {
    position: absolute; left: 0; right: 0; top: 0; height: 56px;
    flex-direction: row; align-items: flex-start; padding: 0 16px;
    background-color: var(--se-surface-0);
    border-bottom-width: 1px; border-color: var(--se-accent-dim);
    transition-property: opacity; transition-duration: 0.6s;
}
.se-topbar-left { flex-direction: row; align-items: center; height: 36px; margin-top: 8px; }
.se-topbar-left > * { margin-right: 8px; }
.se-res-chip { width: 164px; }
.se-res-chip--command { width: 172px; }
.se-res-amount { width: 60px; flex-shrink: 0; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 17px; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; }
.se-res-rate { flex-grow: 1; font-size: 13px; color: var(--se-good); -unity-text-align: middle-right; white-space: nowrap; }
.se-res-rate--zero { color: var(--se-text-dim); }
.se-res-cap { width: 70px; }
.se-res-queued { flex-grow: 1; font-size: 13px; color: var(--se-text-dim); -unity-text-align: middle-right; white-space: nowrap; }
.se-res-queued-icon { width: 11px; height: 11px; margin-left: 3px; flex-shrink: 0; }
.se-res-bar { position: absolute; left: 10px; right: 10px; bottom: 4px; height: 3px; border-radius: 2px; background-color: rgba(255, 255, 255, 0.10); overflow: hidden; }
.se-res-bar-fill { height: 100%; width: 0; background-color: var(--se-good); }
.se-status-pill {
    position: absolute; left: 50%; top: 10px; width: 280px; height: 32px; translate: -50% 0;
    border-radius: 16px; background-color: var(--se-surface-1); border-width: 1px; border-color: var(--se-accent-dim);
    -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 14px; -unity-text-align: middle-center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 12px;
}
.se-status-pill.se-status--bad { background-color: rgba(168, 58, 38, 0.85); border-color: var(--se-bad); }
.se-topbar-right { position: absolute; right: 16px; top: 8px; height: 36px; flex-direction: row; align-items: center; }
.se-topbar-right > * { margin-left: 8px; }
.se-topbar-divider { width: 1px; height: 24px; background-color: var(--se-line); }
.se-observer-chip { width: 160px; }
.se-observer-name { flex-grow: 1; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-civ-dot { width: 10px; height: 10px; border-radius: 5px; margin-right: 8px; flex-shrink: 0; }
.se-popover-row { height: 30px; min-height: 30px; margin: 2px 0 0 0; justify-content: flex-start; }

/* legacy ruleset top bar contents (era pill and goods) inside .se-topbar-left */
.era-pill {
    flex-direction: column; justify-content: center; padding: 0 14px 0 6px; height: 36px;
    border-right-width: 1px; border-color: rgba(255, 255, 255, 0.08);
}
.era-name { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 13px; letter-spacing: 1.5px; color: rgb(236, 204, 136); }
.era-next { font-size: 11px; color: rgb(140, 156, 152); }
.res {
    flex-direction: row; align-items: center; margin-right: 6px; padding: 3px 8px; border-radius: 4px; height: 36px;
    background-color: rgba(255, 255, 255, 0.03);
    transition-property: background-color; transition-duration: 0.15s;
}
.res:hover { background-color: rgba(255, 255, 255, 0.09); }
.res .dot { width: 12px; height: 12px; border-radius: 6px; margin-right: 6px; border-width: 1px; border-color: rgba(0, 0, 0, 0.35); }
.res .amount { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 15px; min-width: 30px; }
.res .rate { font-size: 12px; margin-left: 4px; }
.res.short { background-color: rgba(160, 50, 30, 0.4); border-width: 1px; border-color: rgba(240, 110, 80, 0.5); }
.gauge { width: 80px; height: 6px; background-color: rgba(255, 255, 255, 0.1); border-radius: 3px; margin: 0 6px; overflow: hidden; }
.gauge-fill { height: 100%; background-color: rgb(214, 186, 86); border-radius: 3px; }

/* ================================================================ toasts, banner, alerts (B3) */
.se-toast {
    position: absolute; top: 68px; left: 50%; translate: -50% 0; max-width: 560px; height: 32px; padding: 0 14px;
    background-color: var(--se-surface-1); border-width: 1px; border-color: var(--se-line); border-radius: var(--se-radius);
    font-size: 14px; -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.se-toast.se-toast--bad { color: var(--se-bad); }
.se-toast.se-toast--good { color: var(--se-good); }
.banner { position: absolute; top: 108px; left: 50%; width: 520px; translate: -50% 0; padding: 8px 14px; -unity-text-align: middle-center; border-top-color: var(--se-bad); }
.banner .heading { -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; }
.feed { position: absolute; left: 16px; bottom: 272px; width: 320px; }
.se-note {
    flex-direction: row; align-items: center; min-height: 40px; margin-top: 4px; padding-right: 6px;
    border-radius: var(--se-radius-small); background-color: rgba(10, 15, 17, 0.88); overflow: hidden;
}
.se-note.se-note--critical { background-color: rgba(120, 34, 22, 0.9); }
.se-note-bar { width: 3px; align-self: stretch; background-color: var(--se-warn); flex-shrink: 0; }
.se-note--critical .se-note-bar { background-color: var(--se-bad); }
.se-note-text { flex-grow: 1; flex-shrink: 1; margin: 4px 8px; font-size: 13px; white-space: normal; max-height: 36px; overflow: hidden; text-overflow: ellipsis; }
.result-card { position: absolute; top: 108px; left: 50%; width: 520px; translate: -50% 0; padding: 16px 18px; border-top-color: var(--se-accent); }

/* ================================================================ control groups (B12) */
.se-groups { position: absolute; right: 16px; bottom: 16px; flex-direction: row; justify-content: flex-end; }
.se-group-chip { width: 52px; height: 32px; min-height: 32px; margin-left: 6px; padding: 0 6px; justify-content: center; }
.se-group-digit { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 15px; }
.se-group-count { font-size: 11px; color: var(--se-text-dim); margin-left: 4px; }

/* tutorial */
.coach { position: absolute; right: 16px; top: 66px; width: 340px; padding: 14px; border-top-color: var(--se-accent); }
.highlight { position: absolute; border-width: 3px; border-color: rgb(244, 196, 90); border-radius: 6px; }
.se-pointer { width: 24px; height: 24px; }

/* ---------------------------------------------------------------- legacy buttons (legacy ruleset panels and cards) */
.btn {
    -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold");
    background-color: rgba(36, 47, 50, 0.96);
    border-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-radius: 4px;
    color: rgb(232, 224, 204);
    padding: 5px 10px;
    margin: 2px;
    font-size: 14px;
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, translate;
    transition-duration: 0.12s;
}
.btn:hover { background-color: rgba(56, 70, 70, 0.98); border-color: rgba(230, 186, 96, 0.7); }
.btn:active { background-color: rgba(92, 78, 44, 1); translate: 0 1px; }
.btn.primary { background-color: rgb(184, 138, 54); color: rgb(22, 20, 14); border-color: rgb(238, 198, 112); }
.btn.primary:hover { background-color: rgb(210, 160, 66); }
.btn.selected { border-color: rgb(236, 196, 110); background-color: rgba(98, 82, 44, 0.96); color: rgb(250, 236, 200); }
.btn:disabled { opacity: 0.4; }
/* an icon and its label side by side, never overlapping */
.btn .icon { width: 20px; height: 20px; margin-right: 6px; flex-shrink: 0; }
.btn .label { flex-shrink: 1; -unity-text-align: middle-left; }
/* the legacy side panel's close button: a 28 px icon button, top right */
.panel-close { position: absolute; right: 8px; top: 8px; }
.field { background-color: rgba(0, 0, 0, 0.4); border-color: rgba(255, 255, 255, 0.1); border-width: 1px; border-radius: 4px; color: rgb(234, 226, 206); margin: 2px 0; }
.search { margin-bottom: 8px; }
.tech.match { border-top-color: rgb(120, 200, 255); border-right-color: rgb(120, 200, 255); border-bottom-color: rgb(120, 200, 255); }
.tech.related { background-color: rgba(110, 160, 220, 0.18); }
.panel .ring-site { width: 47%; }
.rail { transition-property: opacity; transition-duration: 0.6s; }

/* ---------------------------------------------------------------- legacy panels, cards and action-card visuals */
.rail { position: absolute; left: 16px; top: 66px; width: 58px; }
.rail .btn { width: 54px; height: 54px; padding: 4px; margin: 0 0 6px 0; flex-direction: column; justify-content: center; background-color: rgba(14, 21, 24, 0.88); }
.rail .btn .icon { width: 24px; height: 24px; margin: 0 0 3px 0; }
.rail .btn .label { font-size: 11px; -unity-text-align: middle-center; color: rgb(196, 192, 178); }
.rail .btn.selected { border-left-width: 3px; border-left-color: rgb(236, 196, 110); }
.rail .btn.selected .label { color: rgb(246, 226, 180); }

.panel { position: absolute; left: 82px; top: 66px; width: 440px; max-height: 78%; padding: 14px 16px; }
.panel.wide { width: 900px; }
.tabs { flex-direction: row; margin-bottom: 10px; flex-wrap: wrap; padding-bottom: 6px; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.06); }

.card {
    position: absolute; bottom: 12px; left: 21%; right: 18%; min-height: 110px; padding: 12px 14px;
}
.action-rail { width: 68px; }
.action-rail .btn { width: 64px; height: 52px; }
.action-train { width: 190px; min-height: 76px; flex-wrap: wrap; justify-content: flex-start; padding: 8px 9px; border-left-width: 2px; border-left-color: rgba(148, 174, 154, .45); }
.action-train .cost { font-size: 11px; color: rgb(162, 182, 177); }
.action-train .label { font-size: 15px; }
.unit-role-caption { width: 100%; font-size: 10px; color: rgb(148, 173, 166); letter-spacing: .35px; margin-top: 4px; white-space: normal; }
.unit-role-description { color: rgb(180, 195, 186); font-size: 13px; white-space: normal; margin: 4px 0 6px 0; }
.action-meter { margin: 4px 0 6px 0; }
.action-meter-track { height: 3px; margin-top: 4px; background-color: rgba(190, 209, 195, .10); border-radius: 2px; overflow: hidden; }
.action-meter-fill { height: 100%; width: 0; background-color: rgb(139, 183, 154); border-radius: 2px; transition-property: width; transition-duration: .16s; }
.production-line { margin-top: 6px; padding: 5px 8px; background-color: rgba(166, 187, 172, .055); border-left-width: 2px; border-left-color: rgba(139, 183, 154, .4); }
.production-line .action-meter { margin-bottom: 0; }
.abilities-row { border-top-width: 1px; border-top-color: rgba(255, 255, 255, .07); margin-top: 5px; padding-top: 5px; }
.action-card .force-chip { font-size: 12px; padding: 3px 7px; color: rgb(208, 219, 210); }
.facility-choice { min-height: 30px; }
.force-chip { background-color: rgba(142, 169, 151, 0.12); border-radius: 3px; margin: 1px 5px 3px 0; padding: 2px 6px; }
.objective-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.objective-marker { position: absolute; padding: 2px 3px; border-radius: 3px; background-color: rgba(13, 20, 22, 0.94); }
.objective-marker .icon { width: 15px; height: 15px; margin-right: 3px; }
.objective-name { font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.objective-track { height: 3px; margin-top: 2px; background-color: rgba(255, 255, 255, 0.16); }
.objective-fill { height: 3px; }
.train-grid { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.train-btn { width: 98px; height: 94px; margin: 3px; padding: 5px 4px; flex-direction: column; align-items: center; justify-content: flex-start; }
.train-btn .icon { width: 44px; height: 32px; margin: 2px 0 3px 0; }
.train-btn .label { font-size: 12px; -unity-text-align: middle-center; white-space: normal; }
.train-btn .cost { font-size: 11px; color: rgb(168, 184, 176); }
.badge {
    position: absolute; right: 3px; top: 3px; min-width: 20px; height: 20px; border-radius: 10px; padding: 0 4px;
    background-color: rgb(206, 158, 66); color: rgb(20, 18, 12); font-size: 12px; -unity-text-align: middle-center;
    -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold");
}
.queue { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.queue-item { width: 48px; height: 42px; margin: 2px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.06); border-width: 1px; border-color: rgba(255, 255, 255, 0.05); align-items: center; justify-content: center; }
.queue-item .icon { width: 34px; height: 24px; }
.queue-item .count { position: absolute; right: 3px; bottom: 0; font-size: 11px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); }
.progress { height: 4px; background-color: rgba(255, 255, 255, 0.1); border-radius: 2px; margin-top: 4px; overflow: hidden; }
.progress-fill { height: 100%; background-color: rgb(142, 212, 132); }

.list-item { padding: 7px 8px; border-radius: 4px; margin-bottom: 2px; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.03); }
.list-item:hover { background-color: rgba(255, 255, 255, 0.05); }

/* research tree: eras left to right, branches colour-coded down each column */
.era { width: 168px; margin-right: 8px; }
.tech {
    margin: 2px 0; padding: 6px 7px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px; border-left-width: 3px; border-color: rgba(255, 255, 255, 0.05);
    transition-property: background-color; transition-duration: 0.12s;
}
.tech:hover { background-color: rgba(255, 255, 255, 0.09); border-right-color: rgba(230, 186, 96, 0.7); border-top-color: rgba(230, 186, 96, 0.7); border-bottom-color: rgba(230, 186, 96, 0.7); }
.tech.done { background-color: rgba(80, 130, 70, 0.28); }
.tech.current { background-color: rgba(120, 100, 50, 0.5); border-top-color: rgb(236, 196, 110); border-right-color: rgb(236, 196, 110); border-bottom-color: rgb(236, 196, 110); }
.tech.queued { border-top-color: rgba(236, 196, 110, 0.45); border-right-color: rgba(236, 196, 110, 0.45); border-bottom-color: rgba(236, 196, 110, 0.45); }
.tech.locked { opacity: 0.5; }
.unlocks { font-size: 10px; color: rgba(220, 214, 196, 0.68); margin-top: 2px; white-space: normal; }
.branch-chip { padding: 2px 8px; margin-right: 6px; margin-bottom: 6px; border-radius: 3px; border-left-width: 3px; background-color: rgba(255, 255, 255, 0.05); }
.branch-civ { border-left-color: rgb(132, 186, 104); }
.branch-industry { border-left-color: rgb(214, 150, 74); }
.branch-infra { border-left-color: rgb(150, 150, 160); }
.branch-logistics { border-left-color: rgb(196, 176, 92); }
.branch-military { border-left-color: rgb(196, 86, 72); }
.branch-advanced { border-left-color: rgb(110, 160, 220); }
.branch-society { border-left-color: rgb(170, 120, 190); }


/* every scroll area has a real viewport: growing content never pushes actions off screen */
.bounded-scroll { flex-shrink: 1; min-height: 0; }
.bounded-scroll > .unity-scroll-view__content-viewport { min-height: 0; }
.bounded-scroll .unity-scroll-view__content-container > * { flex-shrink: 0; }
.bounded-scroll .unity-scroller--vertical { width: 10px; margin-left: 8px; }
.bounded-scroll .unity-scroller__high-button, .bounded-scroll .unity-scroller__low-button { display: none; }
.bounded-scroll .unity-base-slider__dragger { background-color: rgb(139, 128, 100); border-radius: 3px; }
.panel { min-height: 0; }
.panel > .bounded-scroll { margin-top: 22px; }
.action-card > .bounded-scroll { min-height: 0; }
.menu-list { flex-shrink: 0; }

/* loading: real stages over the world (bible §8) */
.loading { position: absolute; left: 50%; bottom: 14%; width: 420px; translate: -50% 0; padding: 16px 20px; }
.loading-title { -unity-font: resource("Fonts/CormorantGaramond"); font-size: 26px; letter-spacing: 4px; color: rgb(242, 230, 198); margin-bottom: 8px; -unity-text-align: middle-center; }
.loading-step { font-size: 13px; color: rgba(200, 200, 190, 0.45); padding: 2px 0; }
.loading-step.done { color: rgb(142, 212, 132); }
.loading-step.current { color: rgb(242, 222, 170); -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); }
.loading-bar { height: 3px; margin-top: 10px; background-color: rgba(255, 255, 255, 0.08); overflow: hidden; }
.loading-bar-run { width: 30%; height: 100%; background-color: rgb(214, 170, 82); }

/* the opening descent's title card (bible §9) */
.title-card { position: absolute; left: 0; right: 0; top: 30%; align-items: center; }
.title-card-main { -unity-font: resource("Fonts/CormorantGaramond"); font-size: 40px; letter-spacing: 3px; color: rgb(244, 234, 210); }
.title-card-sub { font-size: 16px; letter-spacing: 2px; color: rgb(214, 200, 164); margin-top: 4px; }

/* placement card beside the cursor (bible §28) */
.place-card { position: absolute; width: 260px; padding: 8px 10px; }

/* strategic badge counts (bible §29) */
.badge-count {
    position: absolute; font-size: 12px; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); color: rgb(246, 240, 224);
    background-color: rgba(10, 15, 17, 0.75); border-radius: 7px; padding: 0 5px; min-width: 14px; -unity-text-align: middle-center;
}

/* city card summary (bible §31) */
.city-facts { flex-direction: row; flex-wrap: wrap; margin: 6px 0; }
.city-fact { width: 25%; padding-right: 8px; }
.fact-value { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 15px; }
.ring-site-grid { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-top: 7px; margin-bottom: 4px; }
.ring-site { width: 23%; min-height: 42px; margin: 2px; padding: 5px; background-color: rgba(81, 107, 102, .19); border-color: rgba(137, 162, 147, .32); border-width: 1px; }
.ring-site.locked { opacity: .56; background-color: rgba(112, 99, 76, .13); }
.ring-site.available { border-color: rgba(213, 179, 111, .72); background-color: rgba(160, 131, 72, .20); }
.ring-site.selected { border-color: rgb(215, 180, 108); background-color: rgba(159, 128, 72, .22); }
.ring-site .label { flex-grow: 1; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 12px; }
.pickup-reward { position: absolute; -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 16px; color: rgb(242, 216, 160); background-color: rgba(18, 25, 25, .7); border-radius: 4px; padding: 3px 7px; }
.action-card { left: 26%; right: 21%; max-height: 30%; padding: 10px 14px; }
.action-card.expanded-details { max-height: 52%; }
.action-card.active-tool-card { left: 30%; right: 27%; }
.action-card .compact-sites .ring-site { min-height: 28px; margin: 2px; padding: 4px 6px; }
.action-card .compact-sites .ring-site .label { font-size: 11px; }
.context-facilities { margin-top: 6px; }
.context-facility { width: 48%; min-height: 32px; margin: 2px; padding: 5px 7px; }
.context-facility .label { white-space: normal; font-size: 12px; }
.action-card .action-train { width: 23%; min-height: 34px; padding: 5px; margin: 3px; flex-direction: row; }
.action-card .action-train .label { white-space: normal; font-size: 12px; }

/* ================================================================ HUD per the 2026-11-16 mockup (workstream F)
   docs/design/hud_mockup_2026-11-16.png: no top bar (clock top centre, floating pause/menu top right), the
   minimap console bottom-left, the Build/Terrain dock bottom centre, the selection panel bottom-right, the
   unit hover card. Geometry that code relies on: console 420x312 at left 16 / bottom 16 (minimap 240 at its
   bottom-left), dock bottom 16 centred, selection panel 560 wide at right 16 / bottom 16. */

/* the top bar floats: nothing but the clock, the status pill and the right group */
.se-topbar.se-topbar--floating { background-color: rgba(0, 0, 0, 0); border-bottom-width: 0; }
.se-topbar--floating .se-status-pill { top: 50px; height: 28px; font-size: 13px; }
.se-clock {
    position: absolute; left: 50%; top: 10px; height: 30px; translate: -50% 0;
    flex-direction: row; align-items: center; padding: 0 12px 0 10px;
    background-color: rgba(8, 12, 14, 0.86); border-width: 1px; border-color: var(--se-line); border-radius: 4px;
}
.se-clock-glyph { width: 14px; height: 14px; margin-right: 6px; }
.se-clock-text { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 15px; letter-spacing: 0.5px; padding: 0; margin: 0; }

/* ruleset-scoped placement: clear of the clock and of the console */
.se-hud--action .se-toast { top: 88px; }
.se-hud--action .banner, .se-hud--action .result-card { top: 128px; }
.se-hud--action .feed { bottom: 336px; }

/* ---------------------------------------------------------------- minimap console */
.se-console { position: absolute; left: 16px; bottom: 16px; width: 420px; height: 312px; }

.se-attack-banner {
    position: absolute; left: 0; top: 0; height: 34px; max-width: 420px;
    flex-direction: row; align-items: center; padding: 0 18px 0 12px;
    background-color: rgba(16, 12, 12, 0.92); border-left-width: 3px; border-color: var(--se-bad); border-radius: 2px;
}
.se-attack-banner:hover { background-color: rgba(40, 22, 20, 0.95); }
.se-attack-dot { width: 10px; height: 10px; margin-right: 8px; flex-shrink: 0; }
.se-attack-text { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 15px; letter-spacing: 1px; color: var(--se-text); padding: 0; margin: 0; white-space: nowrap; }
.se-attack-hint { font-size: 13px; color: var(--se-text-dim); padding: 0; margin: 0 0 0 12px; white-space: nowrap; }

.se-era-badge { position: absolute; left: 0; top: 66px; width: 50px; height: 56px; align-items: center; justify-content: center; }
.se-era-label { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 10px; letter-spacing: 1.5px; color: rgb(40, 28, 8); padding: 0; margin: 0; -unity-text-align: middle-center; }
.se-era-numeral { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 20px; color: rgb(30, 20, 6); padding: 0; margin: -3px 0 0 0; -unity-text-align: middle-center; }

.se-resbars { position: absolute; left: 224px; top: 146px; width: 190px; flex-direction: column; }
.se-resbar {
    position: relative; height: 26px; min-height: 26px; width: 180px; margin: 0 0 4px 0; padding: 0 20px 0 8px; border-width: 0; border-radius: 0;
    flex-direction: row; align-items: center; justify-content: flex-start; background-color: rgba(0, 0, 0, 0);
}
.se-resbar--energy { margin-left: 6px; }
.se-resbar:hover, .se-resbar:active, .se-resbar:focus { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.se-resbar-icon { width: 16px; height: 16px; margin-right: 6px; flex-shrink: 0; }
.se-resbar-amount { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 15px; width: 66px; flex-shrink: 0; padding: 0; margin: 0; white-space: nowrap; overflow: hidden; color: var(--se-text); }
.se-resbar-rate { flex-grow: 1; font-size: 12px; color: var(--se-good); padding: 0; margin: 0; -unity-text-align: middle-right; white-space: nowrap; }
.se-resbar-rate.se-res-rate--zero { color: var(--se-text-dim); }
.se-resbar-load { position: absolute; left: 30px; right: 26px; bottom: 3px; height: 2px; background-color: rgba(255, 255, 255, 0.10); }
.se-resbar-load-fill { height: 100%; width: 0; background-color: var(--se-good); }

.se-console-round {
    position: absolute; width: 44px; height: 44px; min-height: 0; margin: 0; padding: 0;
    border-radius: 22px; border-width: 1px; border-color: var(--se-accent-dim);
    background-color: var(--se-surface-1); align-items: center; justify-content: center;
    transition-property: background-color, border-color; transition-duration: 0.12s;
}
.se-console-round:hover { background-color: var(--se-surface-hover); border-color: var(--se-accent); }
.se-console-round:active { background-color: rgb(92, 78, 44); }
.se-console-round.selected { border-color: var(--se-accent); background-color: rgba(98, 82, 44, 0.96); }
.se-console-round--empty { opacity: 0.55; }
.se-idle-button { left: 185px; top: 256px; }
.se-idle-glyph { width: 16px; height: 16px; }
.se-idle-count { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 12px; padding: 0; margin: -1px 0 0 0; -unity-text-align: middle-center; color: var(--se-text); }
.se-production-button { left: 236px; top: 262px; width: 36px; height: 36px; border-radius: 18px; }
.se-console-icon { width: 20px; height: 20px; }
.se-zoom-button { left: 192px; top: 82px; width: 30px; height: 30px; border-radius: 15px; }
.se-zoom-glyph { width: 14px; height: 14px; }

/* ---------------------------------------------------------------- bottom-centre dock (Build B, Terrain T) */
.se-dock { position: absolute; left: 50%; bottom: 16px; translate: -50% 0; flex-direction: row; }
.se-dock-button {
    width: 80px; height: 64px; min-height: 0; margin: 0 4px; padding: 6px 4px 4px 4px;
    flex-direction: column; align-items: center; justify-content: center;
    background-color: var(--se-surface-1); border-width: 1px; border-color: var(--se-line); border-radius: 6px;
    transition-property: background-color, border-color; transition-duration: 0.12s;
}
.se-dock-button:hover { background-color: var(--se-surface-hover); border-color: rgba(226, 182, 96, 0.7); }
.se-dock-button:active { background-color: rgb(92, 78, 44); }
.se-dock-button.selected { border-color: var(--se-accent); background-color: rgba(98, 82, 44, 0.96); }
.se-dock-icon { width: 24px; height: 24px; margin-bottom: 4px; }
.se-dock-label { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 12px; padding: 0; margin: 0; white-space: nowrap; color: var(--se-text); }

/* ---------------------------------------------------------------- unit hover card */
.se-hovercard {
    position: absolute; width: 330px; padding: 8px 10px;
    background-color: rgba(10, 14, 16, 0.94); border-width: 1px; border-color: rgba(255, 255, 255, 0.12); border-radius: 4px;
}
.se-hovercard-head { flex-direction: row; align-items: center; height: 22px; }
.se-hovercard-name { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 15px; color: var(--se-text); flex-grow: 1; flex-shrink: 1; padding: 0; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-hovercard-dot { width: 8px; height: 8px; border-radius: 4px; margin: 0 6px 0 8px; }
.se-hovercard-owner { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 12px; padding: 0; margin: 0; white-space: nowrap; flex-shrink: 0; }
.se-hovercard-role { font-size: 12px; color: var(--se-text-dim); white-space: normal; padding: 0; margin: 2px 0 0 0; }
.se-hovercard-status { font-size: 12px; color: var(--se-text); padding: 0; margin: 3px 0 0 0; }

/* ---------------------------------------------------------------- selection panel (bottom-right) */
.se-sel-head { flex-direction: row; align-items: center; height: 36px; margin-bottom: 8px; }
.se-sel-title { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 18px; color: var(--se-text); flex-grow: 1; flex-shrink: 1; padding: 0; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.se-sel-order { height: 32px; min-height: 32px; margin-left: 8px; padding: 0 10px; flex-shrink: 0; }
.se-sel-order .se-btn-label { font-size: 13px; }
.se-sel-order .se-btn-icon { width: 16px; height: 16px; margin-right: 6px; }
.se-sel-attack { border-color: rgba(242, 116, 96, 0.75); }
.se-sel-attack .se-btn-label { color: rgb(250, 172, 152); }
.se-sel-attack:hover { border-color: var(--se-bad); }
.se-sel-attack.selected { background-color: rgba(120, 40, 30, 0.92); border-color: var(--se-bad); }
.se-sel-grid { flex-direction: row; flex-wrap: wrap; }
.se-sel-box {
    width: 170px; height: 56px; margin: 0 6px 6px 0; padding: 6px;
    flex-direction: row; align-items: center;
    background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: var(--se-line); border-radius: 4px;
}
.se-sel-well { width: 40px; height: 40px; margin-right: 8px; flex-shrink: 0; align-items: center; justify-content: center; background-color: rgba(255, 255, 255, 0.06); border-radius: 4px; }
.se-sel-icon { width: 32px; height: 24px; }
.se-sel-box-text { flex-grow: 1; flex-shrink: 1; }
.se-sel-name { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 12px; color: var(--se-text); padding: 0; margin: 0; max-height: 30px; overflow: hidden; }
.se-sel-count { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 13px; color: var(--se-accent); padding: 0; margin: 0; }
.se-sel-count.se-sel-count--hurt { color: var(--se-warn); }

/* ---------------------------------------------------------------- decisive domination countdown (review U)
   under the clock; the status pill steps down to 116 while it shows (Hud.Shell.cs UpdateDominance) */
.se-dominance {
    position: absolute; left: 50%; top: 48px; translate: -50% 0; min-width: 420px; max-width: 640px;
    padding: 6px 16px 7px 16px; align-items: center;
    background-color: rgba(10, 14, 16, 0.92); border-width: 1px; border-left-width: 3px; border-color: var(--se-accent); border-radius: 3px;
}
.se-dominance--ours { border-color: var(--se-good); background-color: rgba(18, 40, 26, 0.92); }
.se-dominance--enemy { border-color: var(--se-bad); background-color: rgba(48, 16, 12, 0.94); }
.se-dominance-title { -unity-font: resource("Fonts/BarlowSemiCondensed-SemiBold"); font-size: 16px; letter-spacing: 1px; color: var(--se-text); padding: 0; margin: 0; -unity-text-align: middle-center; white-space: nowrap; }
.se-dominance-text { font-size: 12px; color: var(--se-text-dim); padding: 0; margin: 2px 0 0 0; -unity-text-align: middle-center; white-space: normal; }
.se-hud--action.se-hud--dominance .se-toast { top: 154px; }
.se-hud--action.se-hud--dominance .banner, .se-hud--action.se-hud--dominance .result-card { top: 196px; }
.se-sel-box--pick:hover { background-color: rgba(255, 255, 255, 0.09); border-color: rgba(226, 182, 96, 0.6); }

/* ================================================================ UI transitions (UiKit.Fx / Show / Hide / Enter)
   Panels, cards, banners, toasts, tool chips, tooltips and the hover card fade with a small slide or scale:
   about 180 ms ease-out in, 140 ms ease-in out (UiKit.InMs / OutMs); UiKit.Hide sets display None only after
   the out-transition. Transitions run on real time, so they also play while the game is paused. Variants:
   --up / --down / --left (a short slide), --cdown / --cup (elements centred with translate -50%), --follow
   (elements moved by translate every frame: their position is never transitioned), --fade (opacity only),
   --quick (tooltips). .se-calm on the root (Settings > Interface > Reduce UI motion) makes them instant. */
.se-fx {
    opacity: 0; scale: 0.97 0.97;
    transition-property: opacity, scale, translate;
    transition-duration: 0.14s;
    transition-timing-function: ease-in;
}
.se-fx.se-in { opacity: 1; scale: 1 1; transition-duration: 0.18s; transition-timing-function: ease-out; }
.se-fx.se-fx--fade, .se-fx.se-fx--fade.se-in { scale: 1 1; }
.se-fx.se-fx--pop { scale: 0.92 0.92; }
.se-fx.se-fx--pop.se-in { scale: 1 1; }
.se-fx.se-fx--up { translate: 0 8px; }
.se-fx.se-fx--up.se-in { translate: 0 0; }
.se-fx.se-fx--down { translate: 0 -8px; }
.se-fx.se-fx--down.se-in { translate: 0 0; }
.se-fx.se-fx--left { translate: -16px 0; scale: 1 1; }
.se-fx.se-fx--left.se-in { translate: 0 0; }
.se-fx.se-fx--cdown { translate: -50% -10px; }
.se-fx.se-fx--cdown.se-in { translate: -50% 0; }
.se-fx.se-fx--cup { translate: -50% 10px; }
.se-fx.se-fx--cup.se-in { translate: -50% 0; }
.se-fx.se-fx--follow, .se-fx.se-fx--follow.se-in { transition-property: opacity, scale; }
.se-fx.se-fx--quick { transition-duration: 0.09s; }
.se-fx.se-fx--quick.se-in { transition-duration: 0.12s; }

/* the pause / confirm frame pops inside its fading dimmer */
.se-dimmer.se-fx .se-frame { scale: 0.96 0.96; transition-property: scale, width, height; transition-duration: 0.14s; transition-timing-function: ease-in; }
.se-dimmer.se-fx.se-in .se-frame { scale: 1 1; transition-duration: 0.2s; transition-timing-function: ease-out; }
/* elements that step to a new place when another appears (the pill and toast under the domination banner) glide there */
.se-status-pill.se-fx, .se-status-pill.se-fx.se-in, .se-toast.se-fx, .se-toast.se-fx.se-in, .banner.se-fx, .banner.se-fx.se-in,
.result-card.se-fx, .result-card.se-fx.se-in { transition-property: opacity, scale, translate, top; }

/* one-shot entrance (UiKit.Enter: list rows, pages, rebuilt panel content) and the page cross-fade (PageStack) */
.se-enter-anim { transition-property: opacity, translate; transition-duration: 0.2s; transition-timing-function: ease-out; }
.se-enter { opacity: 0; translate: 0 6px; }
.se-leave { opacity: 0; transition-property: opacity; transition-duration: 0.12s; transition-timing-function: ease-in; }
/* UiKit.SmoothResize: the selection panel eases to its new height when its content is rebuilt */
.se-resizing, .se-fx.se-resizing, .se-fx.se-in.se-resizing {
    overflow: hidden;
    transition-property: height, opacity, scale; transition-duration: 0.18s; transition-timing-function: ease-out;
}

/* buttons: colour eases, a slight lift on hover and a press-in on click */
.se-btn, .btn {
    transition-property: background-color, border-color, color, scale, translate;
    transition-duration: 0.12s; transition-timing-function: ease-out;
}
.se-btn:hover, .btn:hover { scale: 1.03 1.03; }
.se-btn:active, .btn:active { scale: 0.97 0.97; translate: 0 0; }
.se-pause-item:hover, .se-settings-tab:hover, .se-popover-row:hover, .se-keycap:hover { scale: 1.015 1.015; }
.se-pause-item:active, .se-settings-tab:active, .se-popover-row:active, .se-keycap:active { scale: 0.985 0.985; }
.se-chip, .se-dock-button, .se-console-round, .se-sel-box {
    transition-property: background-color, border-color, scale, opacity;
    transition-duration: 0.12s; transition-timing-function: ease-out;
}
.se-chip:hover, .se-sel-box--pick:hover { scale: 1.03 1.03; }
.se-chip:active, .se-sel-box--pick:active { scale: 0.97 0.97; }
.se-dock-button:hover { scale: 1.04 1.04; }
.se-dock-button:active { scale: 0.96 0.96; }
.se-console-round:hover { scale: 1.06 1.06; }
.se-console-round:active { scale: 0.94 0.94; }
.se-resbar:hover, .se-resbar:active { scale: 1 1; }
/* the idle and production buttons also fade in and out (.se-fx): keep their hover, press and empty looks */
.se-console-round.se-fx, .se-console-round.se-fx.se-in { transition-property: opacity, scale, background-color, border-color; }
.se-console-round.se-fx.se-in:hover { scale: 1.06 1.06; }
.se-console-round.se-fx.se-in:active { scale: 0.94 0.94; }
.se-console-round--empty.se-fx.se-in { opacity: 0.55; }
.se-segment { transition-property: background-color, color; transition-duration: 0.12s; transition-timing-function: ease-out; }
.se-switch .unity-toggle__checkmark { transition-property: background-color, border-color; transition-duration: 0.12s; }
.list-item { transition-property: background-color; transition-duration: 0.12s; }

/* bars ease to their new value instead of jumping (widths set from code at the 4 Hz refresh) */
.se-resbar-load-fill, .se-cmd-bar-fill, .gauge-fill, .progress-fill, .objective-fill, .action-meter-fill {
    transition-property: width, background-color; transition-duration: 0.3s; transition-timing-function: ease-out;
}
.se-cmd-queue-progress { transition-property: width; transition-duration: 0.25s; transition-timing-function: ease-out; }
/* the control-group chips follow the selection panel's height smoothly */
.se-groups, .se-groups.se-fx, .se-groups.se-fx.se-in { transition-property: opacity, scale, bottom; transition-duration: 0.18s; transition-timing-function: ease-out; }

/* jumpiness: text that changes every second sits in a fixed slot, so its box never resizes or re-centres */
.se-clock-text { min-width: 42px; -unity-text-align: middle-center; }
.se-dominance { width: 600px; min-width: 0; max-width: 92%; }
.se-toast { min-width: 220px; }
.se-idle-count { min-width: 20px; }

/* reduce UI motion: every transition above is instant */
.se-calm .se-fx, .se-calm .se-fx.se-in, .se-calm .se-fx.se-fx--quick, .se-calm .se-fx.se-fx--quick.se-in,
.se-calm .se-fx.se-fx--follow, .se-calm .se-fx.se-fx--follow.se-in,
.se-calm .se-dimmer.se-fx .se-frame, .se-calm .se-dimmer.se-fx.se-in .se-frame,
.se-calm .se-enter-anim, .se-calm .se-leave, .se-calm .se-resizing, .se-calm .se-fx.se-in.se-resizing,
.se-calm .se-btn, .se-calm .btn, .se-calm .se-chip, .se-calm .se-dock-button, .se-calm .se-console-round, .se-calm .se-sel-box,
.se-calm .se-resbar-load-fill, .se-calm .se-cmd-bar-fill, .se-calm .gauge-fill, .se-calm .progress-fill, .se-calm .objective-fill,
.se-calm .action-meter-fill, .se-calm .se-cmd-queue-progress, .se-calm .se-groups, .se-calm .se-groups.se-fx.se-in {
    transition-duration: 0s;
}
.se-calm .se-btn:hover, .se-calm .btn:hover, .se-calm .se-chip:hover, .se-calm .se-sel-box--pick:hover,
.se-calm .se-dock-button:hover, .se-calm .se-console-round:hover { scale: 1 1; }
